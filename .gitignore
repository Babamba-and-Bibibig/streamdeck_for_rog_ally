# Default deny: only source, reviewed documentation and templates belong in Git.
# Keep this aligned with scripts/release_policy.py; check_public.py also checks the index/history.
/*
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/README.md
!/README.ko.md
!/README.en.md
!/LICENSE
!/SECURITY.md
!/install.sh
!/Setup OrangeDeck.command
!/Start OrangeDeck Agent.command
!/Enable Codex Notifications.command
!/OrangeDeck.desktop

!/apps/
/apps/**
!/apps/**/
!/apps/**/*.rs
!/apps/**/Cargo.toml
!/crates/
/crates/**
!/crates/**/
!/crates/**/*.rs
!/crates/**/Cargo.toml

!/scripts/
/scripts/**
!/scripts/*.py
!/scripts/*.sh
!/scripts/*.zsh
!/config/
/config/**
!/config/*.example.toml
!/config/*.plist.example
!/docs/
/docs/**
!/docs/ARCHITECTURE.md
!/docs/CONTROLS.md
!/docs/SECURITY.md
!/docs/PROTOCOL.md
!/docs/ROADMAP.md
!/docs/QUICKSTART_KO.md
!/docs/NOTIFICATIONS_KO.md
!/docs/MACOS_SETUP.md
!/docs/INSTALL.md
!/docs/INSTALL.en.md
!/docs/CHANGELOG.md
!/docs/PUBLICATION.md
!/docs/SCREENSHOTS.md

!/download-page/
/download-page/**
!/download-page/README.md
!/download-page/index.html
!/download-page/config.toml
!/download-page/manage.py
!/download-page/package.py
!/download-page/test_manage.py
!/.github/
/.github/**
!/.github/**/
!/.github/**/*.yml
!/.github/**/*.yaml
!/.github/**/*.md

# Private state wins over every allow rule above, even inside source directories.
target/
dist/
.codex/
.agents/
.ssh/
.cargo-home/
.venv/
.pytest_cache/
.idea/
.vscode/
__pycache__/
local/
codex-schema/
AGENTS.md
starter.md
HANDOFF*
PROGRESS.md
USAGE_KO.md
setup_bridge.py
*.local.toml
agent.toml
ui.toml
auth.json
credentials.json
hooks.json
hooks.json.orangedeck-backup-*
owned-codex-threads.json
install-agent.json
install-ui.json
start-agent.command
enable-notifications.command
check-agent.command
start-ui.sh
check-ui.sh
.env*
*.token
*[Pp][Aa][Ii][Rr][Ii][Nn][Gg]*.toml
*[Pp][Aa][Ii][Rr][Ii][Nn][Gg]*.json
*.pem
*.key
*.p12
*.pfx
id_ed25519*
id_rsa*
known_hosts
authorized_keys
*.log
*.jsonl
*.db
*.sqlite*
*.bak
*.pyc
*.zip
*.tar
*.gz
*.tgz
*.7z
*.rar
*.png
*.jpg
*.jpeg
.DS_Store

# Only these five reviewed demo images may be public. The content checker pins
# their SHA256 hashes; replacing one still requires another visual privacy review.
!/docs/screenshots/
!/docs/screenshots/live.png
!/docs/screenshots/shortcuts.png
!/docs/screenshots/projects.png
!/docs/screenshots/conversations.png
!/docs/screenshots/notifications.png

ui-preferences.toml

# Reviewed 0.1.20 English gallery and key editors only.
!/docs/screenshots/key-editor.png
!/docs/screenshots/en-live.png
!/docs/screenshots/en-shortcuts.png
!/docs/screenshots/en-projects.png
!/docs/screenshots/en-conversations.png
!/docs/screenshots/en-notifications.png
!/docs/screenshots/en-key-editor.png

